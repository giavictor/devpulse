generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SavedLink {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}